# Autonomous AI Software Development Factory Environment Configuration
ENVIRONMENT=development
DEFAULT_EXECUTION_MODE=autonomous
DEBUG=false

# Soft launch: invite_only (admin approve) or open
REGISTRATION_MODE=invite_only

# Browser origins allowed to call the API (comma-separated). Never use * in production.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://palramai.in,https://www.palramai.in,https://app.palramai.in

# Public product URLs (hosting may be pending)
PUBLIC_WEBSITE_URL=https://palramai.in
PUBLIC_APP_URL=https://app.palramai.in
PUBLIC_API_URL=https://api.palramai.in

# Allow X-Tenant-Id auth only for local/test automation
ALLOW_TENANT_HEADER_AUTH=false

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./factory.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_factory

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & Secrets (Replace in production)
SECRET_KEY=default-factory-super-secret-key-32-bytes-min!!
ENCRYPTION_KEY=7j8YlQ6xW4K9rL3uP2mE0vN5zC8bA1dF4gH7jK0lM3o=
# Required in production for operator/admin routes
FACTORY_API_TOKEN=

# LLM Providers
DEFAULT_LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest

# GitHub Configuration
GITHUB_TOKEN=
# Set to true only when this process should create and push GitHub repositories.
FACTORY_ENABLE_GITHUB_PUSH=false
GITHUB_USERNAME=naresh-palle
GITHUB_DEFAULT_ORG=

# Meta Developer Platform
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
